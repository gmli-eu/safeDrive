[Unit]
Description=SafeDrive camera: USB camera as MJPEG over HTTP (port 8090)
After=network.target

[Service]
User=arduino
Group=video
ExecStart=/usr/bin/python3 -u /home/arduino/safedrive-camera/stream.py
Environment=WIDTH=1280 HEIGHT=720 FPS=15 PORT=8090
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
